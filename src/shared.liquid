      clip-rule="evenodd"
    />
    <path
      class="nos-logo__o"
      fill-rule="evenodd"
      d="M59.128 29.912c-5.443 0-9.856-4.409-9.856-9.844 0-5.437 4.413-9.845 9.856-9.845s9.857 4.408 9.857 9.845c0 5.435-4.414 9.844-9.857 9.844m0-29.912C48.033 0 39.037 8.983 39.037 20.068c0 11.082 8.996 20.067 20.091 20.067 11.097 0 20.093-8.985 20.093-20.067C79.22 8.983 70.225 0 59.128 0"
      clip-rule="evenodd"
    />
  </svg>
{% endtemplate %}

{% template picture %}
  <div class="nos-image-wrap">
    {% if image and image != "" %}
      <img
        class="nos-image {% if image_style == 'contrast' %}nos-image--contrast{% endif %} image-dither"
        src="{{ image }}"
        alt=""
      >
    {% endif %}
  </div>
{% endtemplate %}

{% template empty_state %}
  <div class="layout nos-screen">
    <div class="nos-empty">
      <div>
        <strong>Geen nieuws beschikbaar</strong>
        <span>{{ message | default: "De NOS-feed kon niet worden geladen." }}</span>
      </div>
    </div>
  </div>
{% endtemplate %}
