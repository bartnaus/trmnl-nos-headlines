  <svg
    class="nos-logo{% if compact %} nos-logo--compact{% endif %}"
    viewBox="0 0 115 41"
    role="img"
    aria-label="NOS"
  >
    <path
      class="nos-logo__mark"
      fill-rule="evenodd"
