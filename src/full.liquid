{% assign settings = display_settings %}
{% assign image_style = settings.image_style | default: "grayscale" %}
{% assign timestamp = settings.show_timestamp | default: "true" %}
{% assign local_now = "now" | date: "%s" | plus: utc_offset %}

{% if status == "error" or items.size == 0 %}
  {% render "empty_state", message: message %}
{% else %}
  <div class="layout nos-screen nos-screen--full bg--white text--black py--medium px--large lg:py--large lg:px--xlarge lg:portrait:p--large">
    <header class="nos-header flex flex--row flex--center-y flex--between pb--small">
      <div class="nos-brand flex flex--row flex--center-y gap--medium">
        {% render "nos_logo" %}
        <span class="nos-section text--base lg:text--xlarge font--bold">{{ section_label | default: "Nieuws" }}</span>
      </div>
      {% if timestamp == "true" or timestamp == true %}
        <span class="nos-timestamp text--small">Bijgewerkt {{ local_now | date: "%H:%M" }}</span>
      {% endif %}
    </header>

    <main class="nos-main grid grid--cols-3 portrait:grid--cols-1 gap--medium lg:gap--large pt--medium lg:pt--large">
      <section class="nos-editorial grid col--span-2 portrait:col--span-1 gap--small lg:gap--medium">
        {% assign lead = items[0] %}
        <article class="nos-lead grid grid--cols-9 portrait:grid--cols-1 gap--medium lg:gap--large pb--small lg:pb--medium">
          {% render "picture", image: lead.image, image_style: image_style, class_name: "col--span-5 portrait:col--span-1" %}
          <div class="nos-story-copy flex flex--col flex--top col--span-4 portrait:col--span-1">
            <h1 class="nos-lead-title text--xxlarge lg:text--xxxlarge lg:portrait:text--xxlarge font--bold m--0" data-clamp="5">{{ lead.title }}</h1>
            <div class="nos-summary text--large lg:text--xlarge mt--small" data-clamp="10">{{ lead.summary }}</div>
          </div>
        </article>

        <div class="nos-cards grid grid--cols-2 gap--small lg:gap--medium lg:portrait:gap--large">
          {% for item in items offset: 1 limit: 2 %}
            <article class="nos-card grid grid--cols-10 portrait:grid--cols-1 gap--small lg:gap--medium">
              {% render "picture", image: item.image, image_style: image_style, class_name: "col--span-3 lg:col--span-4 lg:portrait:col--span-1" %}
              <div class="nos-story-copy flex flex--col flex--top col--span-7 lg:col--span-6 lg:portrait:col--span-1">
                <div class="nos-card-title text--large lg:text--xxlarge font--bold" data-clamp="4">{{ item.title }}</div>
                <div class="nos-card-summary text--large mt--small" data-clamp="7">{{ item.summary }}</div>
              </div>
            </article>
          {% endfor %}
        </div>
      </section>

      <aside class="nos-rail flex flex--col col--span-1 pl--medium lg:pl--large lg:portrait:pl--0 lg:portrait:pt--medium">
        <div class="nos-list grid grid--cols-1 lg:portrait:grid--cols-2 lg:portrait:gap--large">
          {% assign list_limit = 8 %}
          {% for item in items offset: 3 limit: list_limit %}
            <div class="nos-list-item py--small">
              <div class="nos-list-title text--small lg:text--large font--bold" data-clamp="3">{{ item.title }}</div>
            </div>
          {% endfor %}
        </div>
      </aside>
    </main>
  </div>
{% endif %}
