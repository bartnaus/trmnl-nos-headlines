{% assign settings = display_settings %}
{% assign image_style = settings.image_style | default: "grayscale" %}
{% assign timestamp = settings.show_timestamp | default: "true" %}
{% assign local_now = "now" | date: "%s" | plus: utc_offset %}

{% if status == "error" or items.size == 0 %}
  {% render "empty_state", message: message %}
{% else %}
  <div class="layout news-screen news-screen--full bg--white text--black" lang="nl">
    <header class="news-header flex flex--row flex--center-y flex--between pb--small">
      <div class="flex flex--row flex--center-y gap--medium">
        {% render "brand_logo" %}
        <span class="text--small lg:text--base font--bold">{{ section_label | default: "Nieuws" }}</span>
      </div>
      {% if timestamp == "true" or timestamp == true %}
        <span class="timestamp text--small">Bijgewerkt {{ local_now | date: "%H:%M" }}</span>
      {% endif %}
    </header>

    <main class="news-content grid grid--cols-3 portrait:grid--cols-1 gap--medium lg:gap--large">
      <section class="editorial col--span-2 portrait:col--span-1 gap--small lg:gap--medium">
        {% assign lead = items[0] %}
        <article class="lead-story grid grid--cols-9 portrait:grid--cols-1 gap--medium lg:gap--large">
          {% render "picture", image: lead.image, image_style: image_style, class_name: "col--span-5 portrait:col--span-1" %}
          <div class="story-copy flex flex--col flex--top col--span-4 portrait:col--span-1">
            <h1 class="story-heading text--large lg:text--xlarge lg:portrait:text--large font--bold m--0" data-clamp="5">{{ lead.title }}</h1>
            <div class="story-summary text--base lg:text--large text--justify mt--small" data-clamp="10">{{ lead.summary }}</div>
          </div>
        </article>

        <div class="story-cards grid grid--cols-2 gap--small lg:gap--medium lg:portrait:gap--large">
          {% for item in items offset: 1 limit: 2 %}
            <article class="story-card grid grid--cols-10 portrait:grid--cols-1 gap--small lg:gap--medium">
              {% render "picture", image: item.image, image_style: image_style, class_name: "col--span-3 lg:col--span-4 lg:portrait:col--span-1" %}
              <div class="story-copy flex flex--col flex--top gap--small col--span-7 lg:col--span-6 lg:portrait:col--span-1">
                <div class="story-heading title title--small lg:title--base font--bold" data-clamp="4">{{ item.title }}</div>
                <div class="story-card-summary description description--large font--regular text--justify" data-clamp="5">{{ item.summary }}</div>
              </div>
            </article>
          {% endfor %}
        </div>
      </section>

      <aside class="headline-rail flex flex--col col--span-1 lg:portrait:pt--medium">
        <div class="headline-list grid grid--cols-1 lg:portrait:grid--cols-2 lg:portrait:gap--large">
          {% assign list_limit = 7 %}
          {% for item in items offset: 3 limit: list_limit %}
            <div class="headline-item py--small">
              <div class="text--base lg:text--large font--bold" data-clamp="3">{{ item.title }}</div>
            </div>
          {% endfor %}
        </div>
      </aside>
    </main>
  </div>
{% endif %}
