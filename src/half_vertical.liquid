{% assign settings = display_settings %}
{% if status == "error" or items.size == 0 %}
  {% render "empty_state", message: message %}
{% else %}
  <div class="layout news-screen bg--white text--black">
    <header class="news-header flex flex--row flex--center-y flex--between pb--small">
      <div class="flex flex--row flex--center-y gap--medium">{% render "brand_logo", compact: false %}<span class="text--small lg:text--base font--bold">{{ section_label | default: "Nieuws" }}</span></div>
    </header>
    {% assign lead = items[0] %}
    <div class="half-image pt--medium">
      {% render "picture", image: lead.image, image_style: settings.image_style %}
    </div>
    <h1 class="text--large font--bold mt--medium" data-clamp="4">{{ lead.title }}</h1>
    <div class="headline-list grid grid--cols-1 mt--small">
      {% for item in items offset: 1 limit: 4 %}
        <div class="headline-item py--small"><div class="text--small lg:text--base font--bold" data-clamp="2">{{ item.title }}</div></div>
      {% endfor %}
    </div>
  </div>
{% endif %}
