{% assign settings = display_settings %}
{% if status == "error" or items.size == 0 %}
  {% render "empty_state", message: message %}
{% else %}
  <div class="layout news-screen bg--white text--black">
    <header class="news-header flex flex--row flex--center-y flex--between pb--small">
      <div class="flex flex--row flex--center-y gap--medium">{% render "brand_logo" %}<span class="text--small lg:text--base font--bold">{{ section_label | default: "Nieuws" }}</span></div>
      <span class="kicker text--small font--bold">Net binnen</span>
    </header>
    <div class="news-content grid grid--cols-9 gap--medium lg:gap--large pt--medium lg:pt--large">
      {% assign lead = items[0] %}
      <article class="lead-story lead-story--compact grid grid--cols-2 col--span-5 gap--medium p--0">
        {% render "picture", image: lead.image, image_style: settings.image_style, class_name: "col--span-1" %}
        <div class="story-copy flex flex--col flex--top col--span-1"><h1 class="text--large lg:text--xlarge font--bold m--0" data-clamp="5">{{ lead.title }}</h1></div>
      </article>
      <aside class="headline-rail flex flex--col col--span-4">
        <div class="headline-list grid grid--cols-1">
          {% for item in items offset: 1 limit: 5 %}
            <div class="headline-item py--small"><div class="text--small lg:text--base font--bold" data-clamp="2">{{ item.title }}</div></div>
          {% endfor %}
        </div>
      </aside>
    </div>
  </div>
{% endif %}
