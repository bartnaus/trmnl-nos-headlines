{% assign settings = display_settings %}
{% if status == "error" or items.size == 0 %}
  {% render "empty_state", message: message %}
{% else %}
  <div class="layout nos-screen nos-screen--half-horizontal bg--white text--black py--medium px--large lg:py--large lg:px--xlarge">
    <header class="nos-header flex flex--row flex--center-y flex--between pb--small">
      <div class="nos-brand flex flex--row flex--center-y gap--medium">{% render "nos_logo" %}<span class="nos-section text--base lg:text--xlarge font--bold">{{ section_label | default: "Nieuws" }}</span></div>
      <span class="nos-kicker text--small font--bold">Net binnen</span>
    </header>
    <div class="nos-main grid grid--cols-9 gap--medium lg:gap--large pt--medium lg:pt--large">
      {% assign lead = items[0] %}
      <article class="nos-lead nos-lead--half-horizontal grid grid--cols-2 col--span-5 gap--medium p--0">
        {% render "picture", image: lead.image, image_style: settings.image_style, class_name: "col--span-1" %}
        <div class="nos-story-copy flex flex--col flex--top col--span-1"><h1 class="nos-lead-title text--xxlarge lg:text--xxxlarge font--bold m--0" data-clamp="5">{{ lead.title }}</h1></div>
      </article>
      <aside class="nos-rail flex flex--col col--span-4 pl--medium lg:pl--large">
        <div class="nos-list grid grid--cols-1">
          {% for item in items offset: 1 limit: 5 %}
            <div class="nos-list-item py--small"><div class="nos-list-title text--small lg:text--large font--bold" data-clamp="2">{{ item.title }}</div></div>
          {% endfor %}
        </div>
      </aside>
    </div>
  </div>
{% endif %}
