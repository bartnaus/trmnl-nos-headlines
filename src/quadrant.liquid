{% assign settings = display_settings %}
{% if status == "error" or items.size == 0 %}
  {% render "empty_state", message: message %}
{% else %}
  <div class="layout news-screen news-screen--quadrant bg--white text--black">
    <header class="news-header news-header--compact flex flex--row flex--center-y flex--between pb--small">
      <div class="flex flex--row flex--center-y gap--medium">{% render "brand_logo", compact: true %}<span class="text--base font--bold">{{ section_label | default: "Nieuws" }}</span></div>
    </header>
    <div class="headline-list grid grid--cols-1">
      {% for item in items limit: 6 %}
        <div class="headline-item py--small"><div class="text--small font--bold" data-clamp="2">{{ item.title }}</div></div>
      {% endfor %}
    </div>
  </div>
{% endif %}
